# Copy to .env.local and fill in. Never commit real values.

# Google Gemini (the ONLY AI provider in this app)
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-3.8-flash

# Supabase (optional — app falls back to config/default-config.json without it)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Protects /api/cron (Vercel sends it as a Bearer token)
CRON_SECRET=any-long-random-string
